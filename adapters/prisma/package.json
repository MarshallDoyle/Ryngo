{
  "name": "@codegraph/adapter-prisma",
  "version": "0.1.0",
  "description": "codegraph framework adapter for Prisma. Parses schema.prisma into Model/Field/Relation IR nodes and lifts prisma client calls (findMany, create, $queryRaw, ...) into typed db-read / db-write edges from caller functions to model nodes.",
  "license": "MIT",
  "homepage": "https://github.com/codegraph/codegraph/tree/main/adapters/prisma#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codegraph/codegraph.git",
    "directory": "adapters/prisma"
  },
  "bugs": {
    "url": "https://github.com/codegraph/codegraph/issues"
  },
  "keywords": [
    "codegraph",
    "codegraph-adapter",
    "prisma",
    "orm",
    "static-analysis",
    "ir",
    "db-edges"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node18",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist .turbo .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@codegraph/adapter-sdk": "workspace:*",
    "@mrleebo/prisma-ast": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@codegraph/adapter-sdk": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "codegraph": {
    "adapter": {
      "name": "prisma",
      "idScheme": "prisma",
      "apiVersion": 1
    }
  }
}
