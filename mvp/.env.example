# Local Docker Compose defaults for Ryngo.
#
# Copy to `.env` only if you need to override values. The compose file has
# safe local defaults, so `npm run db:up` works without copying this file.

POSTGRES_DB=ryngo
POSTGRES_USER=ryngo
POSTGRES_PASSWORD=ryngo_dev_password
RYNGO_DB_PORT=55432
RYNGO_APP_PORT=8080

# Enables optional usage and compiler-quality event writes.
DATABASE_URL=postgres://ryngo:ryngo_dev_password@localhost:55432/ryngo
RYNGO_EVENT_SALT=local-dev-change-me
