# tree-sitter peer-dep conflict (Phase 5.1.0):
#   tree-sitter-python  declares  tree-sitter@^0.22.1 as peer
#   tree-sitter-javascript pins   tree-sitter@^0.21.1 as peer
# Both work fine against our installed 0.22.4 — `npm install` /
# `npm ci` would otherwise refuse to resolve. Setting this here means
# local dev + Docker build agree without needing the explicit flag
# in every command.
legacy-peer-deps=true
